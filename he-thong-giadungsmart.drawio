        <mxCell id="db_script_note" value="&lt;b&gt;Tệp CSDL đính kèm:&lt;/b&gt; &lt;span style=&quot;color:#B45309;&quot;&gt;server/database.sql&lt;/span&gt; chứa sẵn cấu trúc bảng và dữ liệu mẫu đầy đủ để import vào phpMyAdmin (XAMPP)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontSize=10.5;align=center;" vertex="1" parent="grp_database">
