        <mxCell id="note_auth_rule" value="&lt;b style=&quot;color:#B45309;&quot;&gt;⚠️ Quy Tắc Bảo Vệ Tuyệt Đối:&lt;/b&gt;&lt;br/&gt;Người dùng thường truy cập trái phép &lt;b&gt;/admin&lt;/b&gt; sẽ bị &lt;b&gt;ProtectedRoute&lt;/b&gt; chặn ngay lập tức và đẩy về trang &lt;b&gt;403 Từ chối truy cập&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="grp_users">
