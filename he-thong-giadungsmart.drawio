        <!-- TIÊU ĐỀ HỆ THỐNG -->
        <mxCell id="hdr_banner" value="&lt;b style=&quot;font-size: 20px; color: #1E293B;&quot;&gt;SƠ ĐỒ KIẾN TRÚC TOÀN DIỆN HỆ THỐNG THƯƠNG MẠI ĐIỆN TỬ GIA DỤNG SMART&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 13px; color: #475569;&quot;&gt;React 19 Frontend (Vite + Tailwind) • Phân quyền Admin / Customer • Cổng thanh toán VietQR MBBank • Node.js Express API • CSDL XAMPP MySQL&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;shadow=1;arcSize=8;align=center;" vertex="1" parent="1">
