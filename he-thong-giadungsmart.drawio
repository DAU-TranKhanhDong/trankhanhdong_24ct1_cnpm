        </mxCell>

        <mxCell id="cmp_routes" value="&lt;b&gt;AppRoutes.jsx &amp;amp; ProtectedRoute.jsx&lt;/b&gt;&lt;br/&gt;• Kiểm tra vai trò (Role-based access)&lt;br/&gt;• Khách vào /admin ➔ Chặn chuyển hướng ngay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="sub_auth">
