        <mxCell id="cmp_auth_ctx" value="&lt;b&gt;AuthContext.jsx&lt;/b&gt;&lt;br/&gt;• DEFAULT_ADMIN cố định&lt;br/&gt;• SessionStorage (Mới vào là chưa login)&lt;br/&gt;• register() chỉ tạo role: customer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="sub_auth">
