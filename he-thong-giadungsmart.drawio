        <!-- Subgroup: Giao diện các trang UI -->
        <mxCell id="sub_pages" value="🖥️ Giao Diện 2 Phân Hệ Người Dùng" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#334155;startSize=25;rounded=1;" vertex="1" parent="grp_frontend">
          <mxGeometry x="20" y="340" width="630" height="430" as="geometry" />
        </mxCell>

        <mxCell id="page_customer" value="&lt;b style=&quot;color:#1D4ED8; font-size:13px;&quot;&gt;🛍️ PHÂN HỆ KHÁCH HÀNG (CUSTOMER)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;&lt;b&gt;• TrangChu.jsx:&lt;/b&gt; Banner quảng bá, sản phẩm bán chạy&lt;br/&gt;&lt;b&gt;• TrangSanPham.jsx:&lt;/b&gt; Bộ lọc giá, danh mục, thương hiệu&lt;br/&gt;&lt;b&gt;• TrangChiTietSanPham.jsx:&lt;/b&gt; Thông số, hình ảnh, đánh giá&lt;br/&gt;&lt;b&gt;• TrangGioHang.jsx:&lt;/b&gt; Tăng/giảm số lượng, mã giảm giá&lt;br/&gt;&lt;b&gt;• TrangThanhToan.jsx:&lt;/b&gt; Nhập địa chỉ &amp; chọn VietQR MBBank&lt;br/&gt;&lt;b&gt;• TrangDatHangThanhCong.jsx:&lt;/b&gt; Mã đơn &amp; hướng dẫn nhận hàng&lt;br/&gt;&lt;b&gt;• TrangLichSuDonHang.jsx:&lt;/b&gt; Theo dõi tiến độ đơn hàng cá nhân" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="sub_pages">
          <mxGeometry x="15" y="35" width="290" height="380" as="geometry" />
        </mxCell>

        <mxCell id="page_admin" value="&lt;b style=&quot;color:#7E22CE; font-size:13px;&quot;&gt;⚙️ PHÂN HỆ QUẢN TRỊ VIÊN (ADMIN)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;&lt;b&gt;• TongQuanQuanTri.jsx:&lt;/b&gt; Báo cáo doanh thu, đơn hàng&lt;br/&gt;&lt;b&gt;• QuanLySanPham.jsx:&lt;/b&gt; Thêm mới, chỉnh sửa giá/ảnh, xóa SP&lt;br/&gt;&lt;b&gt;• QuanLyDonHang.jsx:&lt;/b&gt; Xác nhận thanh toán VietQR, giao hàng&lt;br/&gt;&lt;b&gt;• QuanLyNguoiDung.jsx:&lt;/b&gt; Xem danh sách, phân quyền, khóa tài khoản&lt;br/&gt;&lt;b&gt;• QuanLyKhuyenMai.jsx:&lt;/b&gt; Phát hành voucher mã giảm giá&lt;br/&gt;&lt;b&gt;• QuanLyDanhGia.jsx:&lt;/b&gt; Kiểm duyệt bình luận của khách hàng&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;color:#7E22CE; font-weight:bold;&quot;&gt;=&gt; Được bảo vệ bởi ProtectedRoute yêu cầu role = 'admin'&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#C084FC;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="sub_pages">
          <mxGeometry x="325" y="35" width="290" height="380" as="geometry" />
        </mxCell>

        <!-- Subgroup: VietQR Component UI -->
        <mxCell id="sub_vietqr_ui" value="📱 Component Thanh Toán VietQR MBBank" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#0369A1;startSize=25;rounded=1;" vertex="1" parent="grp_frontend">
          <mxGeometry x="20" y="785" width="630" height="130" as="geometry" />
        </mxCell>

        <mxCell id="cmp_vietqr_box" value="&lt;b style=&quot;font-size:12px; color:#0369A1;&quot;&gt;KhungThanhToanVietQR.jsx&lt;/b&gt;&lt;br/&gt;• Tích hợp ảnh mã QR MBBank chuẩn sạch: &lt;b&gt;/qr-payment-clean.png&lt;/b&gt; (Đã che STK vì bảo mật)&lt;br/&gt;• Chủ tài khoản: &lt;b&gt;TRAN KHANH DONG&lt;/b&gt; | Ngân hàng TMCP Quân Đội MBBank&lt;br/&gt;• Nút &quot;Tôi đã chuyển khoản thành công&quot; kích hoạt pháo hoa &lt;b&gt;canvas-confetti&lt;/b&gt; và chốt đơn tức thì" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#38BDF8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="sub_vietqr_ui">
          <mxGeometry x="15" y="35" width="600" height="80" as="geometry" />
        </mxCell>


        <!-- ==================== KHỐI 4: TẦNG BACKEND NODE.JS EXPRESS ==================== -->
        <mxCell id="grp_backend" value="⚙️ TẦNG BACKEND (NODE.JS + EXPRESS REST API)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#059669;strokeWidth=2.5;fontSize=15;fontStyle=1;fontColor=#065F46;startSize=35;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1090" y="110" width="510" height="380" as="geometry" />
        </mxCell>

        <mxCell id="node_app" value="&lt;b style=&quot;font-size:13px; color:#065F46;&quot;&gt;server/src/app.js (Express Server - Port 3000)&lt;/b&gt;&lt;br/&gt;• Middleware: cors(), express.json(), express.urlencoded()&lt;br/&gt;• Khởi động máy chủ và tự động gọi &lt;b&gt;connectDB()&lt;/b&gt; khi khởi chạy&lt;br/&gt;• Cung cấp các Endpoint REST API cho Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="grp_backend">
          <mxGeometry x="20" y="50" width="470" height="75" as="geometry" />
        </mxCell>

        <mxCell id="node_routes" value="&lt;b style=&quot;font-size:12px; color:#065F46;&quot;&gt;Routes &amp;amp; Controllers (API Kiểm Tra &amp;amp; Trạng Thái)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;GET /api/v1/health&lt;/b&gt; ➔ Trả về trạng thái hoạt động của Backend&lt;br/&gt;• &lt;b&gt;GET /api/v1/db-status&lt;/b&gt; ➔ Kiểm tra trực tiếp kết nối tới MySQL XAMPP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4ADE80;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="grp_backend">
          <mxGeometry x="20" y="135" width="470" height="65" as="geometry" />
        </mxCell>

        <mxCell id="node_db_config" value="&lt;b style=&quot;font-size:13px; color:#047857;&quot;&gt;server/src/config/db.js (Module Kết Nối Database)&lt;/b&gt;&lt;br/&gt;• Sử dụng thư viện &lt;b&gt;mysql2/promise&lt;/b&gt;&lt;br/&gt;• Tạo &lt;b&gt;Connection Pool&lt;/b&gt; (waitForConnections: true, connectionLimit: 10)&lt;br/&gt;• Hàm &lt;b&gt;connectDB()&lt;/b&gt; thực hiện truy vấn thử nghiệm: &lt;i&gt;SELECT 1 + 1 AS solution&lt;/i&gt;&lt;br/&gt;• Ghi log rõ ràng: &lt;b&gt;[DATABASE] Ket noi MySQL (XAMPP) thanh cong!&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=2;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="grp_backend">
          <mxGeometry x="20" y="210" width="470" height="90" as="geometry" />
        </mxCell>

        <mxCell id="node_env" value="&lt;b&gt;Cấu hình biến môi trường server/.env:&lt;/b&gt;&lt;br/&gt;PORT=3000 | DB_HOST=localhost | DB_PORT=3306 | DB_USER=root | DB_PASSWORD=&quot;&quot; | DB_NAME=giadungsmart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontSize=10;align=center;" vertex="1" parent="grp_backend">
          <mxGeometry x="20" y="310" width="470" height="50" as="geometry" />
        </mxCell>


        <!-- ==================== KHỐI 5: TẦNG CƠ SỞ DỮ LIỆU MYSQL TRÊN XAMPP ==================== -->
        <mxCell id="grp_database" value="🗄️ TẦNG CƠ SỞ DỮ LIỆU MYSQL TRÊN XAMPP (PORT 3306)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2.5;fontSize=15;fontStyle=1;fontColor=#92400E;startSize=35;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1090" y="520" width="510" height="520" as="geometry" />
        </mxCell>

        <mxCell id="db_server" value="&lt;b style=&quot;font-size:14px; color:#B45309;&quot;&gt;🐬 DỊCH VỤ XAMPP MYSQL (mysqld.exe - Port 3306)&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Database Name:&lt;/b&gt; giadungsmart | &lt;b&gt;Charset:&lt;/b&gt; utf8mb4_unicode_ci&lt;br/&gt;&lt;b&gt;Tài khoản kết nối:&lt;/b&gt; root / Không mật khẩu (Mặc định XAMPP)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontSize=11;align=center;" vertex="1" parent="grp_database">
          <mxGeometry x="35" y="45" width="440" height="75" as="geometry" />
        </mxCell>

        <!-- Các bảng dữ liệu -->
