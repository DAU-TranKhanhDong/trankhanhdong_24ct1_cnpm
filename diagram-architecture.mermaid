graph TB
    %% PHÂN HỆ NGƯỜI DÙNG
    subgraph USERS ["👥 TẦNG NGƯỜI DÙNG & PHÂN QUYỀN"]
        direction LR
        Admin["👑 QUẢN TRỊ VIÊN (ADMIN)<br/>admin@gmail.com / pass: 123<br/>(Có tất cả mọi quyền hệ thống)"]
        Customer["🛒 KHÁCH HÀNG (CUSTOMER)<br/>(Chỉ quyền mua sắm, cấm vào admin)"]
        Guest["🌐 KHÁCH VÃNG LAI<br/>(Chưa đăng nhập)"]
    end

    %% TẦNG FRONTEND REACT
    subgraph FRONTEND ["💻 TẦNG FRONTEND (REACT 19 + VITE + TAILWIND CSS)"]
        direction TB

        subgraph AUTH_MODULE ["Xác Thực & Điều Hướng"]
            AppRoutes["Tuyến Đường (AppRoutes.jsx)"]
            ProtectedRoute{"Bộ Lọc Bảo Vệ (ProtectedRoute)<br/>Khách vào Admin -> Chặn 403"}
            Login["Trang Đăng Nhập (TrangDangNhap.jsx)<br/>Nút Admin 1-chạm & Khách"]
            Register["Trang Đăng Ký (TrangDangKy.jsx)<br/>Chỉ tạo tài khoản Customer"]
            AccessDenied["Trang Từ Chối 403 (TrangTuChoiTruyCap.jsx)"]
        end

        subgraph STATE_CTX ["Quản Lý Trạng Thái (Context API)"]
            AuthCtx["AuthContext.jsx<br/>(Lưu session, Admin cố định)"]
            CartCtx["CartContext.jsx<br/>(Giỏ hàng & Voucher)"]
            ProductCtx["ProductContext.jsx<br/>(Tồn kho & Danh mục)"]
            OrderCtx["OrderContext.jsx<br/>(Tạo đơn & Xác nhận QR)"]
        end

        subgraph UI_PAGES ["Giao Diện Các Phân Hệ"]
            CustPages["Phân Hệ Khách Hàng:<br/>• TrangChu.jsx, TrangSanPham.jsx<br/>• TrangChiTietSanPham.jsx<br/>• TrangGioHang.jsx, TrangThanhToan.jsx<br/>• TrangDatHangThanhCong.jsx<br/>• TrangLichSuDonHang.jsx"]
            AdminPages["Phân Hệ Quản Trị (Admin Panel):<br/>• TongQuanQuanTri.jsx (Báo cáo)<br/>• QuanLyNguoiDung.jsx (Khóa/Mở user)<br/>• QuanLySanPham.jsx (Thêm/Sửa/Xóa)<br/>• QuanLyDonHang.jsx (Duyệt đơn)<br/>• QuanLyKhuyenMai.jsx (Voucher)"]
        end

        subgraph PAYMENT_UI ["Component Thanh Toán Mã QR"]
            QRComp["KhungThanhToanVietQR.jsx<br/>• Ảnh QR MBBank sạch bảo mật<br/>• Đã che số tài khoản<br/>• Tên: TRAN KHANH DONG<br/>• Nút 'Đã chuyển khoản' + Confetti"]
        end
    end

    %% TẦNG CỔNG THANH TOÁN
    subgraph GATEWAY ["💳 CỔNG THANH TOÁN VIETQR"]
        VietQR["Hệ Thống VietQR / Napas 247<br/>Ngân hàng Quân Đội (MBBank)<br/>Tự nhận diện chủ TK & số tiền"]
    end

    %% TẦNG BACKEND NODE.JS
    subgraph BACKEND ["⚙️ TẦNG BACKEND (NODE.JS + EXPRESS SERVER)"]
        direction TB
        ServerApp["server/src/app.js<br/>(Express REST API Port 3000)"]
        HealthRoute["Routes & Controllers<br/>• /api/v1/health<br/>• /api/v1/db-status"]
        DBConfig["server/src/config/db.js<br/>Hàm connectDB() Connection Pool"]
        EnvFile["server/.env<br/>DB_HOST=localhost | PORT=3306<br/>DB_NAME=giadungsmart"]
    end

    %% TẦNG DATABASE XAMPP
    subgraph DATABASE ["🗄️ TẦNG CƠ SỞ DỮ LIỆU MYSQL (XAMPP PORT 3306)"]
        direction TB
        MySQLCore[("MySQL Database: giadungsmart<br/>(mysqld.exe service trên XAMPP)")]
        
        subgraph TABLES ["Các Bảng Dữ Liệu (database.sql)"]
            T_Users["users<br/>(id, name, email, password, role)"]
            T_Products["products<br/>(id, name, price, stock, category_id)"]
            T_Orders["orders & order_items<br/>(id, total, payment_method, status)"]
            T_Categories["categories & brands<br/>(Danh mục & Thương hiệu)"]
            T_Promos["promotions<br/>(Voucher giảm giá)"]
        end
    end

    %% LIÊN KẾT GIỮA CÁC TẦNG
    Guest -->|Xem sản phẩm| CustPages
    Guest -->|Bấm đăng nhập / đăng ký| Login
    Guest -->|Bấm đăng ký| Register
    Customer -->|Mua hàng & Đặt hàng| CustPages
    Customer -.->|Cố tình vào /admin| ProtectedRoute
    ProtectedRoute -->|Chặn quyền| AccessDenied

    Admin -->|Đăng nhập tài khoản Admin| Login
    Admin -->|Có tất cả mọi quyền| AdminPages
    Admin -->|Xem gian hàng| CustPages

    Login -->|Cập nhật vai trò| AuthCtx
    Register -->|Tạo quyền customer| AuthCtx

    AuthCtx --> AppRoutes
    AppRoutes --> CustPages
    AppRoutes --> AdminPages

    CustPages --> CartCtx
    CustPages --> ProductCtx
    CustPages --> OrderCtx
    CustPages --> QRComp

    QRComp -->|Quét mã thanh toán| VietQR
    VietQR -.->|Xác nhận giao dịch| OrderCtx

    %% KẾT NỐI TỪ FRONTEND TỚI BACKEND & CSDL
    FRONTEND -->|Gọi API RESTful| ServerApp
    ServerApp --> HealthRoute
    ServerApp -->|Khởi chạy kết nối| DBConfig
    EnvFile -.->|Nạp thông số kết nối| DBConfig
    DBConfig -->|connectDB Connection Pool| MySQLCore

    MySQLCore --- T_Users
    MySQLCore --- T_Products
    MySQLCore --- T_Orders
    MySQLCore --- T_Categories
    MySQLCore --- T_Promos

    %% STYLE ĐỒ HỌA
    classDef userStyle fill:#f8fafc,stroke:#475569,stroke-width:2px;
    classDef adminStyle fill:#f3e8ff,stroke:#7e22ce,stroke-width:3px;
    classDef reactStyle fill:#eff6ff,stroke:#2563eb,stroke-width:2px;
    classDef backendStyle fill:#ecfdf5,stroke:#059669,stroke-width:2px;
    classDef dbStyle fill:#fffbeb,stroke:#d97706,stroke-width:3px;
    classDef qrStyle fill:#eff6ff,stroke:#0284c7,stroke-width:2px;

    class Admin adminStyle;
    class Customer,Guest userStyle;
    class FRONTEND reactStyle;
    class BACKEND backendStyle;
    class DATABASE dbStyle;
    class QRComp,VietQR qrStyle;
